# --- Rules & constants ---

_EXPECTATIONS_{{ safe_source_view }} = {{ expectations|py_literal }}

_INVERSE_FILTER_{{ safe_source_view }} = {{ inverse_filter|py_literal }}

_FAILED_RULE_EXPRS_{{ safe_source_view }} = [
{% for rule in failed_rule_data %}
    F.when(
        ~F.expr({{ rule.rule|py_literal }}),
        F.struct(
            F.lit({{ rule.name|py_literal }}).alias("name"),
            F.lit({{ rule.rule|py_literal }}).alias("rule"),
        ),
    ),
{% endfor %}
]

DLQ_TABLE_{{ safe_source_view }} = {{ dlq_table|py_str }}
DLQ_OUTBOX_TABLE_{{ safe_source_view }} = {{ dlq_outbox_table|py_str }}
SOURCE_TABLE_{{ safe_source_view }} = {{ source_table|py_str }}
{% if hash_exclude_columns %}

_HASH_EXCLUDE_COLS_{{ safe_source_view }} = {{ hash_exclude_columns|py_literal }}
{% endif %}

_EXPECTATIONS_RECYCLED_{{ safe_source_view }} = {{ recycled_expectations|py_literal }}


# --- Clean path (provides DQ metrics in event log) ---
@dp.temporary_view()
@dp.expect_all_or_drop(_EXPECTATIONS_{{ safe_source_view }})
def _clean_{{ safe_source_view }}():
    """{{ description|py_block(at_delimiter=False) }} — clean records"""
    return spark.readStream.table({{ source_view|py_str }})


# --- Quarantine path (DLQ sink + routing) ---
@dp.foreach_batch_sink(name="dlq_sink_{{ safe_source_view }}")
def dlq_sink_{{ safe_source_view }}(batch_df, batch_id):
    """Write quarantined rows to DLQ table"""
    if batch_df.isEmpty():
        return

    spark = batch_df.sparkSession
    data_cols = [c for c in batch_df.columns if not c.startswith("_dlq")]
{% if hash_exclude_columns %}
    _exclude = set(_HASH_EXCLUDE_COLS_{{ safe_source_view }})
    hash_cols = [c for c in data_cols if c not in _exclude]
{% else %}
    hash_cols = data_cols
{% endif %}

    batch = (
        batch_df
        .withColumns({
            "_row_json": F.to_json(F.struct(*hash_cols)),
            "_dlq_sk": F.xxhash64(
                F.lit(SOURCE_TABLE_{{ safe_source_view }}), F.to_json(F.struct(*hash_cols))
            ).cast("string"),
        })
    )

    if "_rescued_data" in batch_df.columns:
        _map_type = MapType(StringType(), StringType())
        variant_cols = [c for c in data_cols if c != "_rescued_data"]
        batch = (
            batch
            .withColumns({
                "_variant_json": F.when(
                    F.col("_rescued_data").isNotNull(),
                    F.to_json(
                        F.map_zip_with(
                            F.coalesce(F.from_json(F.to_json(F.struct(*variant_cols)), _map_type), F.create_map()),
                            F.map_filter(
                                F.coalesce(F.from_json(F.col("_rescued_data"), _map_type), F.create_map()),
                                lambda k, v: k != "_file_path",
                            ),
                            lambda k, v1, v2: F.coalesce(v2, v1),
                        )
                    ),
                ).otherwise(F.to_json(F.struct(*variant_cols))),
            })
            .withColumns({
                "_row_data": F.parse_json(F.col("_variant_json")),
            })
            .withColumnRenamed("_rescued_data", "_dlq_rescued_data")
        )
    else:
        batch = (
            batch
            .withColumns({
                "_row_data": F.parse_json(F.to_json(F.struct(*data_cols))),
                "_dlq_rescued_data": F.lit(None).cast("string"),
            })
        )

    batch = (
        batch
        .withColumns({
            "_dlq_source_table": F.lit(SOURCE_TABLE_{{ safe_source_view }}),
            "_dlq_status": F.lit("quarantined"),
            "_dlq_timestamp": F.current_timestamp(),
        })
        .select(
            "_dlq_sk", "_dlq_source_table", "_dlq_status",
            "_dlq_timestamp", "_dlq_failed_rules", "_dlq_rescued_data",
            "_row_data",
        )
    )

    dlq = DeltaTable.forName(spark, DLQ_TABLE_{{ safe_source_view }})
    (
        dlq.alias("dlq")
        .merge(
            batch.alias("new"),
            (F.col("dlq._dlq_source_table") == F.lit(SOURCE_TABLE_{{ safe_source_view }}))
            & (F.col("dlq._dlq_sk") == F.col("new._dlq_sk")),
        )
        .whenNotMatchedInsertAll()
        .execute()
    )
    return


@dp.append_flow(target="dlq_sink_{{ safe_source_view }}", name="quarantine_flow_{{ safe_source_view }}")
def quarantine_flow_{{ safe_source_view }}():
    """Route failed rows to DLQ"""
    return (
        spark.readStream.table({{ source_view|py_str }})
        .filter(_INVERSE_FILTER_{{ safe_source_view }})
        .withColumn("_dlq_failed_rules",
            F.array_compact(F.array(*_FAILED_RULE_EXPRS_{{ safe_source_view }}))
        )
    )


# --- Recycle path (dedup inbox → outbox) ---
@dp.foreach_batch_sink(name="recycle_sink_{{ safe_source_view }}")
def recycle_sink_{{ safe_source_view }}(batch_df, batch_id):
    """Deduplicate fixed DLQ rows and write to outbox"""
    if batch_df.isEmpty():
        return

    spark = batch_df.sparkSession
    w = Window.partitionBy("_dlq_sk").orderBy(F.desc("_commit_version"))
    deduped = (
        batch_df.withColumn("_rn", F.row_number().over(w))
        .filter("_rn = 1")
        .drop("_rn")
        .select(
            "_dlq_sk",
            "_dlq_source_table",
            "_row_data",
            F.current_timestamp().alias("_dlq_recycled_at"),
        )
    )

    outbox = DeltaTable.forName(spark, DLQ_OUTBOX_TABLE_{{ safe_source_view }})
    (
        outbox.alias("out")
        .merge(
            deduped.alias("new"),
            (F.col("out._dlq_source_table") == F.lit(SOURCE_TABLE_{{ safe_source_view }}))
            & (F.col("out._dlq_sk") == F.col("new._dlq_sk")),
        )
        .whenNotMatchedInsertAll()
        .execute()
    )


@dp.append_flow(
    target="recycle_sink_{{ safe_source_view }}", name="recycle_flow_{{ safe_source_view }}"
)
def recycle_flow_{{ safe_source_view }}():
    """Read fixed rows from DLQ inbox via CDF"""
    return (
        spark.readStream.option("readChangeFeed", "true")
        .table(DLQ_TABLE_{{ safe_source_view }})
        .filter(
            (F.col("_dlq_status") == "fixed")
            & F.col("_change_type").isin("insert", "update_postimage")
            & (F.col("_dlq_source_table") == F.lit(SOURCE_TABLE_{{ safe_source_view }}))
        )
    )


# --- Recycled path (outbox → validated recycled view) ---
@dp.temporary_view()
@dp.expect_all_or_drop(_EXPECTATIONS_RECYCLED_{{ safe_source_view }})
def _recycled_{{ safe_source_view }}():
    """Validate recycled rows from DLQ outbox"""
    clean = spark.readStream.table("_clean_{{ safe_source_view }}")
    return (
        spark.readStream.option("skipChangeCommits", "true")
        .table(DLQ_OUTBOX_TABLE_{{ safe_source_view }})
        .filter(F.col("_dlq_source_table") == F.lit(SOURCE_TABLE_{{ safe_source_view }}))
        .select([
            F.try_variant_get(F.col("_row_data"), f"$.{field.name}", field.dataType.simpleString()).alias(field.name)
            for field in clean.schema.fields
        ])
    )


# --- Validated output (clean + recycled) ---
@dp.temporary_view()
def {{ target_view }}():
    """{{ description|py_block(at_delimiter=False) }} — clean + recycled records"""
    clean = spark.readStream.table("_clean_{{ safe_source_view }}")
    recycled = spark.readStream.table("_recycled_{{ safe_source_view }}")

    df = clean.union(recycled)
    {% if add_operational_metadata %}

    # Add operational metadata columns
    df = df.withColumns({
        {%- for col_name, expression in metadata_columns.items()|sort %}
        {{ col_name|py_str_single }}: {{ expression }}{{ "," if not loop.last }}
        {%- endfor %}
    })
    {% endif %}

    return df
