@dp.temporary_view()
{% if fail_expectations %}
# These expectations will fail the pipeline if violated
@dp.expect_all_or_fail({{ fail_expectations|py_literal }})
{% endif %}
{% if drop_expectations %}
# These expectations will drop rows that violate them
@dp.expect_all_or_drop({{ drop_expectations|py_literal }})
{% endif %}
{% if warn_expectations %}
# These expectations will log warnings but not drop rows
@dp.expect_all({{ warn_expectations|py_literal }})
{% endif %}
def {{ target_view }}():
    """{{ description|py_block }}"""
    {% if readMode == "stream" %}
    df = spark.readStream.table({{ source_view|py_str }})
    {% else %}
    df = spark.read.table({{ source_view|py_str }})
    {% endif %}
    {% if add_operational_metadata %}
    
    # Add operational metadata columns
    df = df.withColumns({
        {%- for col_name, expression in metadata_columns.items()|sort %}
        {{ col_name|py_str_single }}: {{ expression }}{{ "," if not loop.last }}
        {%- endfor %}
    })
    {% endif %}
    
    return df
