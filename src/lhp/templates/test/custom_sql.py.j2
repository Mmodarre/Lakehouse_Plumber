{% if add_imports %}
from pyspark import pipelines as dp
from pyspark.sql.functions import *

{% endif %}
{% if fail_expectations %}
@dp.expect_all_or_fail({{ fail_expectations|py_literal }})
{% endif %}
{% if drop_expectations %}
@dp.expect_all_or_drop({{ drop_expectations|py_literal }})
{% endif %}
{% if warn_expectations %}
@dp.expect_all({{ warn_expectations|py_literal }})
{% endif %}
@dp.table(name={{ target|py_str }}, comment={{ description|py_str }}, temporary=True)
def {{ target }}():
    """{{ description|py_block }}"""
{% if sql %}
    return spark.sql("""
{% set _lines = sql.strip().split('\n') %}
{% for line in _lines %}
{% if loop.first %}        {{ line.strip()|py_block(at_delimiter=False) }}
{% else %}        {{ line|py_block(at_delimiter=False) }}
{% endif %}
{% endfor %}
    """)
{%- else %}
    return spark.table({{ source|py_str }})
{%- endif %}
