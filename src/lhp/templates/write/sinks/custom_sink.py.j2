# {{ comment|py_comment }}

# Register custom data sink
spark.dataSource.register({{ custom_sink_class }})

# Create custom sink
dp.create_sink(
    name={{ sink_name|py_str }},
    format="{{ datasink_format_name }}",
    options={{ options|py_literal }}
)

# Define append flow(s)
{% for source_view in source_views %}
@dp.append_flow(
    target={{ sink_name|py_str }},
    name={{ ("f_" ~ sink_name ~ "_" ~ loop.index)|py_str }},
    comment="""{{ description|py_block }}"""
)
def f_{{ sink_name }}_{{ loop.index }}():
    df = spark.readStream.table({{ source_view|py_str }})
    
    {% if add_operational_metadata %}
    # Add operational metadata columns
    {% for col_name, expression in metadata_columns.items()|sort %}
    df = df.withColumn({{ col_name|py_str_single }}, {{ expression }})
    {% endfor %}
    {% endif %}
    
    return df
{% endfor %}

