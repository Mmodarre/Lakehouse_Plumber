@dp.temporary_view()
def {{ target_view }}():
    """{{ description|py_block }}"""
    df = spark.readStream \
        .format("kafka")
    {%- for key, value in reader_options.items() %}
    {%- if value is boolean %} \
        .option({{ key|py_str }}, {{ value|string|title }})
    {%- elif value is number %} \
        .option({{ key|py_str }}, {{ value }})
    {%- else %} \
        .option({{ key|py_str }}, {{ value|py_str }})
    {%- endif %}
    {%- endfor %} \
        .load()
    
    {% if add_operational_metadata %}
    # Add operational metadata columns
    {% for col_name, expression in metadata_columns.items()|sort %}
    df = df.withColumn({{ col_name|py_str_single }}, {{ expression }})
    {% endfor %}
    {% endif %}
    
    return df

