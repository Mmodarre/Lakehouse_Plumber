{% if schema_variable %}
# Define schema
{% for line in schema_code_lines %}
{{ line }}
{% endfor %}

{% endif %}
{% if schema_hints_variable %}
# Schema hints for {{ schema_hints_label|py_comment }} table
{{ schema_hints_variable }} = """
{% for column in schema_hints_columns %}
{% if loop.last %}
    {{ column|py_block(at_delimiter=False) }}
{% else %}
    {{ column|py_block(at_delimiter=False) }},
{% endif %}
{% endfor %}
""".strip().replace("\n", " ")


{% endif %}
@dp.temporary_view()
def {{ target_view }}():
    """{{ description|py_block }}"""
    df = spark.readStream \
        .format("cloudFiles")
    {%- if schema_variable %} \
        .schema({{ schema_variable }})
    {%- endif %}
    {%- for key, value in reader_options.items() %}
    {%- if value is boolean %} \
        .option({{ key|py_str }}, {{ value|string|title }})
    {%- elif value is number %} \
        .option({{ key|py_str }}, {{ value }})
    {%- else %} \
        .option({{ key|py_str }}, {{ value|py_str }})
    {%- endif %}
    {%- endfor %}
    {%- if schema_hints_variable %} \
        .option("cloudFiles.schemaHints", {{ schema_hints_variable }})
    {%- endif %} \
        .load({{ path|py_str }})
    {% if add_operational_metadata %}
    
    # Add operational metadata columns
    {% for col_name, expression in metadata_columns.items()|sort %}
    df = df.withColumn({{ col_name|py_str_single }}, {{ expression }})
    {% endfor %}
    {% endif %}
    
    return df 